%% -*- erlang -*-
{erl_opts, [debug_info]}.
{deps, []}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    exports_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{xref_ignores, [
    %% rebar3 runtime APIs provided by the host rebar3
    {rebar_api, info, 2},
    {rebar_api, warn, 2},
    {rebar_api, debug, 2},
    {rebar_app_info, name, 1},
    {rebar_app_info, out_dir, 1},
    {rebar_state, all_deps, 1},
    {rebar_state, current_app, 1},
    {rebar_state, get, 3},
    {rebar_state, set, 3},
    {rebar_state, current_profiles, 1},
    {rebar_state, project_apps, 1},
    {rebar_state, add_provider, 2},
    {providers, create, 1},
    %% dialyzer fallback path used on OTP releases without get_core_from_beam/1
    {dialyzer_utils, get_abstract_code_from_beam, 1},
    {dialyzer_utils, get_core_from_abstract_code, 1},
    %% unused public API kept for compatibility
    {rebar3_erlando_file, ensure_dir, 1}
]}.

{project_plugins, [
    {rebar3_docker_ci, {git, "https://github.com/slepher/rebar3_docker_ci.git", {tag, "0.5.1"}}},
    {rebar3_reltree, {git, "https://github.com/slepher/rebar3_reltree.git", {tag, "0.1.3"}}}
]}.

{docker_ci, [
    {erlang_versions, ["21", "22", "23", "24", "25", "26", "27", "28", "29"]}
]}.
